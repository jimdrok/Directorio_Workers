{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "la-guaira-conecta",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "DIRECTORY", "class_name": "Directory" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Directory"] }]
}
